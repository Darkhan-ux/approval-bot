# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather. Без него запустится только дашборд.
BOT_TOKEN=

# true  — открытый доступ: любой пользователь Telegram получает все роли маршрута.
# false — доступ только у сотрудников из списка, роли назначаются по списку.
OPEN_ACCESS=true

# Администраторы: Telegram ID или @ник через запятую. Могут аннулировать любую заявку
# и вернуть её на этап (с причиной). Также роль «администратор» можно задать в списке сотрудников.
ADMINS=

# Часовой пояс для дат в сообщениях, таблице и дашборде
TIMEZONE=Asia/Almaty

# Google Таблица (необязательно). Без этих двух строк журнал в таблицу не пишется,
# а сотрудники берутся из config/staff.yaml.
# GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
# GOOGLE_SHEET_ID=

# Веб-дашборд
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Пароль на дашборд (логин любой). Пусто — без пароля.
DASHBOARD_PASSWORD=

# Только для сервера (docker compose): домен дашборда и токен DuckDNS
# DOMAIN=zayavki-kz.duckdns.org
# DUCKDNS_TOKEN=

# База данных. По умолчанию — файл data/app.db
# DATABASE_URL=sqlite+aiosqlite:///data/app.db
